NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ministryflow?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
